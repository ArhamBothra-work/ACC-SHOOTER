# ACC Shooter Agent environment configuration
# Copy this file to /etc/acc-agent.env and edit the values accordingly.

# Backend HTTP API URL (required)
API_URL=https://q9u78vshof.execute-api.ap-south-1.amazonaws.com

# AWS region for SigV4 signing (required)
AWS_REGION=ap-south-1

# Public address of this EC2 instance (optional – if omitted, IMDS public IP is used)
PUBLIC_ADDRESS=

# UDP game port that the Unity server will bind to (required)
GAME_PORT=7777

# Maximum player capacity reported to the backend (required)
CAPACITY=10

# Absolute path to the Linux server binary (required). Must be executable.
SERVER_BINARY=/opt/acc/ACCServer.x86_64

# Local loopback port for the agent's HTTP endpoints (required)
AGENT_PORT=8081

# Heartbeat interval in seconds (optional – defaults to 20.0)
HEARTBEAT_INTERVAL=20.0

# Optional path for the Unity server log file (optional)
SERVER_LOG=/opt/acc/server.log
